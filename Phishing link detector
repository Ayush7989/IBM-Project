from flask import Flask, request, render_template_string
from urllib.parse import urlparse
from datetime import datetime
import whois
import re

app = Flask(__name__)

HTML = """
<!DOCTYPE html>
<html>
<head>
<title>Phishing Website Detector</title>

<style>

body{
    font-family: Arial, sans-serif;
    background:#f4f6f9;
    margin:0;
    padding:0;
}

.container{
    width:800px;
    margin:50px auto;
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:0px 0px 15px rgba(0,0,0,0.2);
}

h1{
    text-align:center;
    color:#0f172a;
}

input{
    width:75%;
    padding:12px;
    font-size:16px;
}

button{
    padding:12px 20px;
    background:#2563eb;
    color:white;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#1d4ed8;
}

.result{
    margin-top:25px;
    padding:15px;
    border-radius:5px;
}

.safe{
    background:#dcfce7;
}

.suspicious{
    background:#fef9c3;
}

.phishing{
    background:#fee2e2;
}

ul{
    text-align:left;
}

.footer{
    text-align:center;
    margin-top:20px;
    color:gray;
}

</style>

</head>
<body>

<div class="container">

<h1>🛡️ Phishing Website Detector</h1>

<form method="POST">
<input type="text"
       name="url"
       placeholder="Enter Website URL"
       required>

<button type="submit">Analyze</button>
</form>

{% if result %}

<div class="result {{ result_class }}">

<h2>Result: {{ result }}</h2>

<h3>Risk Score: {{ score }}/100</h3>

<h3>Warnings:</h3>

<ul>
{% for warning in warnings %}
<li>{{ warning }}</li>
{% endfor %}
</ul>

</div>

{% endif %}

<div class="footer">
Cyber Security Project
</div>

</div>

</body>
</html>
"""

def analyze_url(url):

    score = 100
    warnings = []

    if not url.startswith("https://"):
        score -= 20
        warnings.append("Website is not using HTTPS.")

    parsed = urlparse(url)
    domain = parsed.netloc

    ip_pattern = r"^(\\d{1,3}\\.){3}\\d{1,3}$"

    if re.match(ip_pattern, domain):
        score -= 30
        warnings.append("IP address used instead of domain.")

    if len(url) > 75:
        score -= 15
        warnings.append("Long URL detected.")

    if "@" in url:
        score -= 20
        warnings.append("@ symbol detected in URL.")

    suspicious_words = [
        "login",
        "verify",
        "secure",
        "update",
        "banking",
        "account"
    ]

    for word in suspicious_words:
        if word in url.lower():
            score -= 5
            warnings.append(
                f"Suspicious keyword found: {word}"
            )

    try:

        info = whois.whois(domain)
        creation_date = info.creation_date

        if isinstance(creation_date, list):
            creation_date = creation_date[0]

        if creation_date:

            age = (datetime.now() - creation_date).days

            if age < 180:
                score -= 25
                warnings.append(
                    f"Domain is only {age} days old."
                )

    except:
        warnings.append(
            "Unable to verify domain age."
        )

    if score < 0:
        score = 0

    if score >= 80:
        result = "SAFE"
        result_class = "safe"

    elif score >= 50:
        result = "SUSPICIOUS"
        result_class = "suspicious"

    else:
        result = "PHISHING"
        result_class = "phishing"

    return score, result, warnings, result_class


@app.route("/", methods=["GET", "POST"])
def home():

    score = None
    result = None
    warnings = []
    result_class = ""

    if request.method == "POST":

        url = request.form["url"]

        score, result, warnings, result_class = analyze_url(url)

    return render_template_string(
        HTML,
        score=score,
        result=result,
        warnings=warnings,
        result_class=result_class
    )


if __name__ == "__main__":
    app.run(debug=True)
